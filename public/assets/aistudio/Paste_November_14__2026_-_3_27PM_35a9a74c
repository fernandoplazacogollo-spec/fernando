function guardarEmpleado(){ const nom=document.getElementById('f-nombres').value.trim(),ape=document.getElementById('f-apellidos').value.trim(),doc=document.getElementById('f-doc').value.trim(); if(!nom||!ape||!doc){showToast('Completa los campos obligatorios *','error');return;} if(editId){const e=empleados.find(x=>x.id===editId);e.nombres=nom;e.apellidos=ape;e.doc=doc;e.email=document.getElementById('f-email').value;e.cargo=document.getElementById('f-cargo').value;e.dep=document.getElementById('f-dep').value;showToast('Empleado actualizado','success');} else{empleados.unshift({id:Date.now(),doc,nombres:nom,apellidos:ape,email:document.getElementById('f-email').value||'nuevo@humanpro.com',cargo:document.getElementById('f-cargo').value,dep:document.getElementById('f-dep').value,ingreso:document.getElementById('f-fecha').value,salario:parseInt(document.getElementById('f-salario').value||0),estado:'Activo',foto:'https://i.pravatar.cc/80?img=5'});showToast(`Empleado ${nom} ${ape} creado`,'success');} closeModalEmpleado(); renderAll(); show('empleados'); }
function verDetalle(id){ const e=empleados.find(x=>x.id===id); document.getElementById('detalleContent').innerHTML=`<div class="flex gap-4 items-center"><img src="${e.foto}" class="w-16 h-16 rounded-2xl"><div><p class="font-extrabold text-lg">${e.nombres} ${e.apellidos}</p><p class="text-sm text-slate-500">${e.cargo} • ${e.dep}</p><span class="badge-activo px-2 py-1 rounded-full text-xs font-bold">${e.estado}</span></div></div><div class="grid grid-cols-2 gap-3 mt-5 text-sm"><div class="bg-slate-50 p-3 rounded-xl"><p class="text-xs text-slate-400">Documento</p><p class="font-semibold">${e.doc}</p></div><div class="bg-slate-50 p-3 rounded-xl"><p class="text-xs text-slate-400">Correo</p><p class="font-semibold">${e.email}</p></div><div class="bg-slate-50 p-3 rounded-xl"><p class="text-xs text-slate-400">Ingreso</p><p class="font-semibold">${e.ingreso}</p></div><div class="bg-slate-50 p-3 rounded-xl"><p class="text-xs text-slate-400">Salario</p><p class="font-semibold">$${e.salario.toLocaleString()}</p></div></div>`; document.getElementById('modalDetalle').classList.remove('hidden'); }
function editarEmpleado(id){const e=empleados.find(x=>x.id===id);editId=id;document.getElementById('f-nombres').value=e.nombres;document.getElementById('f-apellidos').value=e.apellidos;document.getElementById('f-doc').value=e.doc;document.getElementById('f-email').value=e.email;document.getElementById('modalTitle').innerText='Editar Empleado';document.getElementById('modalEmpleado').classList.remove('hidden');}
function eliminarEmpleado(id){if(confirm('¿Estás seguro de eliminar este empleado?')){empleados=empleados.filter(x=>x.id!==id);renderEmpleados();showToast('Empleado eliminado','warning');}}
function crearDepartamento(){const n=document.getElementById('nuevoDepNombre').value.trim();if(!n)return showToast('Escribe el nombre','error');departamentos.push({nombre:n,desc:document.getElementById('nuevoDepDesc').value||'Nuevo departamento',total:0,color:'bg-indigo-100',icon:'🏢'});document.getElementById('kpiDep').innerText=departamentos.length;renderDept();showToast('Departamento '+n+' creado','success');}
function crearCargo(){const n=document.getElementById('nuevoCargo').value.trim();if(!n)return showToast('Escribe el nombre del cargo','error');cargos.push({nombre:n,dep:document.getElementById('nuevoCargoDep').value,salario:parseInt(document.getElementById('nuevoCargoSalario').value||0),total:0});renderCargos();showToast('Cargo '+n+' creado','success');}
function crearNovedad(){novedades.unshift({emp:document.getElementById('novEmp').value,tipo:document.getElementById('novTipo').value,desc:document.getElementById('novDesc').value||'Sin descripción',estado:'Pendiente'});renderNovedades();showToast('Novedad registrada','success');}
function aprobarNov(i){novedades[i].estado='Aprobada';renderNovedades();showToast('Novedad aprobada','success');}
function rechazarNov(i){novedades[i].estado='Rechazada';renderNovedades();showToast('Novedad rechazada','warning');}
function guardarAsistencia(){showToast('Asistencia guardada','success');}
function renderAll(){renderEmpleados();renderDept();renderCargos();renderAsistencia();renderNovedades();renderActividad();}
let chartsInit=false;
function initCharts(){ if(chartsInit) return; chartsInit=true; new Chart(document.getElementById('chartDep'),{type:'bar',data:{labels:['Tecnología',[STRIPPED] Humano'],datasets:[{data:[42,[STRIPPED] const c2=document.getElementById('chartAsist'); if(c2) new Chart(c2,{type:'line',data:{labels:['Lun',[STRIPPED] const c3=document.getElementById('chartNov'); if(c3) new Chart(c3,{type:'doughnut',data:{labels:['Vacaciones',[STRIPPED] }
renderAll();
</script>
